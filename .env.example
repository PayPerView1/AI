# Set GEMINI_API_KEY from Google AI Studio. Never commit a populated .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_REQUEST_TIMEOUT=45

# Must match the Express backend JWT_SECRET used to issue PayPerView access tokens.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Shared only between Express and this service; never expose in browser configuration.
AI_SERVICE_API_KEY=

# Use the local backend in development and the canonical Express API URL in deployment.
BACKEND_URL=http://localhost:5000
BACKEND_TIMEOUT_SECONDS=10
FRONTEND_ORIGINS=http://localhost:3000

CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=60
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_MESSAGES=12
MAX_HISTORY_CHARS=12000

# Local persistent Chroma is used when CHROMA_URL is blank.
CHROMA_URL=
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION=brands_clippers_kb

AI_SERVICE_PORT=8001
